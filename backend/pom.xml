<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.5</version>
        <relativePath/>
    </parent>

    <groupId>br.com.fiap.flexcheck</groupId>
    <artifactId>flexcheck-parent</artifactId>
    <version>0.1.0</version>
    <packaging>pom</packaging>

    <name>FlexCheck Parent</name>
    <description>Aggregator and shared dependency management for the FlexCheck platform</description>

    <modules>
        <module>services/api-gateway</module>
        <module>services/admin-service</module>
        <module>services/biometry-service</module>
        <module>services/checkin-service</module>
        <module>services/device-service</module>
        <module>services/identity-service</module>
        <module>services/key-service</module>
        <module>services/notification-service</module>
        <module>services/payment-service</module>
        <module>services/pms-adapter-service</module>
        <module>services/reservation-service</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <ojdbc.version>23.6.0.24.10</ojdbc.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.oracle.database.jdbc</groupId>
                <artifactId>ojdbc11</artifactId>
                <version>${ojdbc.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.3</version>
                    <configuration>
                        <useModulePath>false</useModulePath>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>

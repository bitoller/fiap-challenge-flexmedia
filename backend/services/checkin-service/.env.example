# Check-in service - exemplo de configuracao local

# Oracle FIAP remoto, conforme Data Source da IDE:
ORACLE_URL=jdbc:oracle:thin:@oracle.fiap.com.br:1521:ORCL
ORACLE_USER=rm552726
ORACLE_PASSWORD=coloque-sua-senha-aqui

# Hibernate/JPA cria ou atualiza as tabelas a partir das entidades.
# Use update no Oracle compartilhado. Evite create e create-drop no banco da FIAP.
JPA_DDL_AUTO=update

# Porta padrao da API
SERVER_PORT=8080

# Frontends permitidos durante desenvolvimento
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

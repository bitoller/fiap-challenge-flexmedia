# FlexCheck Hotel - Oracle FIAP

COMPOSE_PROJECT_NAME=flexcheck

# Aplicacao usando Oracle FIAP remoto com SID ORCL
ORACLE_URL=jdbc:oracle:thin:@oracle.fiap.com.br:1521:ORCL
ORACLE_USER=rm552726
ORACLE_PASSWORD=coloque-sua-senha-aqui
JPA_DDL_AUTO=update
JWT_SECRET=change-me-local
PMS_MODE=MOCK
PAYMENT_MODE=MOCK
BIOMETRY_MODE=MOCK
KEY_ISSUER_MODE=MOCK

# Portas usadas pela demo Docker
CHECKIN_PORT=8081
GATEWAY_PORT=8088
KIOSK_PORT=3000
KIOSK_API_URL=/api/v1

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

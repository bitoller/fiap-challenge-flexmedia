COMPOSE_PROJECT_NAME=flexcheck
ORACLE_URL=jdbc:oracle:thin:@oracle.fiap.com.br:1521:ORCL
ORACLE_USER=your_oracle_user
ORACLE_PASSWORD=your_oracle_password
ORACLE_SYS_PASSWORD=your_local_oracle_sys_password
JPA_DDL_AUTO=update
JWT_SECRET=change_me_to_a_long_random_value
SENSITIVE_DATA_SECRET=change_me_to_a_long_random_sensitive_data_secret
ADMIN_USERNAME=admin@example.local
ADMIN_PASSWORD=change_me_admin_password
ADMIN_NAME=FlexCheck Administrator
PMS_MODE=MOCK
PAYMENT_MODE=MOCK
BIOMETRY_MODE=MOCK
KEY_ISSUER_MODE=MOCK
IDENTITY_DEMO_AUTO_APPROVE=false
IDENTITY_DOCUMENT_ONLY_FALLBACK_ENABLED=true

# OCR.space free API key:
# 1. Create a free key at https://ocr.space/ocrapi/freekey
# 2. Paste the key below.
# 3. Without this key, document verification remains unavailable and does not approve check-in.
OCR_SPACE_API_KEY=

# CompreFace face verification:
# 1. Start CompreFace locally with infra/compreface/download-compreface.ps1 and infra/compreface/start-compreface.ps1.
# 2. Create a Face Verification service in the CompreFace UI.
# 3. Use http://host.docker.internal:8000 when FlexCheck runs in Docker.
#    Use http://localhost:8000 only when the check-in service runs directly on your machine.
# 4. Paste the service API key below.
# 5. If CompreFace is not configured, the flow can continue only when document-only fallback is enabled and the OCR document check was approved.
COMPREFACE_URL=
COMPREFACE_API_KEY=
COMPREFACE_THRESHOLD=85
RESERVATION_SERVICE_URL=http://localhost:8082
PAYMENT_SERVICE_URL=http://localhost:8083
KEY_SERVICE_URL=http://localhost:8084
ADMIN_SERVICE_URL=http://localhost:8085
DEVICE_SERVICE_URL=http://localhost:8089
IDENTITY_SERVICE_URL=http://localhost:8090
BIOMETRY_SERVICE_URL=http://localhost:8086
PMS_SERVICE_URL=http://localhost:8087
NOTIFICATION_SERVICE_URL=http://localhost:8091
CHECKIN_PORT=8081
GATEWAY_PORT=8088
KIOSK_PORT=3000
KIOSK_API_URL=/api/v1
ADMIN_WEB_API_URL=/api/v1
ADMIN_WEB_PORT=3001

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
